{
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Run api",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "justMyCode": false,
            "args": [
                "src.apps.fastapi.main:app",
                "--port",
                "8001",
                "--reload"
            ],
            "jinja": true
        },
        {
            "name": "Run test unit",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "justMyCode": false,
            "args": [
                "./",
                "-m",
                "unit"
            ]
        },

        {
            "name": "Run setup",
            "type": "debugpy",
            "preLaunchTask": "up-services",
            "request": "launch",
            "module": "scripts.local_setup",
            "args": [],
            "jinja": true
        }
    ]
}