{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "down-services",
            "command": "make",
            "args": [
                "down"
            ],
            "type": "shell"
        },
        {
            "label": "up-services",
            "command": "make",
            "args": [
                "up"
            ],
            "type": "shell",
            "dependsOn": "down-services",
            "problemMatcher": []
        },
        {
            "label": "migration",
            "options": {
                "cwd": "./src/migration/core"
            },
            "command": "alembic",
            "args": [
                "revision",
                "--autogenerate",
                "-m",
                "\"${input:migrationMessage}\""
            ],
            "type": "shell"
        }
    ],
    "inputs": [
        {
            "id": "migrationMessage",
            "type": "promptString",
            "description": "Add migration message",
            
        }
    ]
}
